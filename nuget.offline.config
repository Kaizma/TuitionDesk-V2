<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline/restricted-environment restore sources.
  Use this file instead of nuget.config when the machine cannot reach nuget.org.
  Normal development uses nuget.config (nuget.org).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-feed" value=".nuget\feed" />
    <add key="global-cache" value="%USERPROFILE%\.nuget\packages" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".nuget\packages" />
  </config>
</configuration>
