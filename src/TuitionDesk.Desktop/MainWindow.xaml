<Window x:Class="TuitionDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TuitionDesk"
        Width="1200"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />

        <Border x:Name="LoadingOverlay" Background="#F8FAFC">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Border Width="56"
                        Height="56"
                        CornerRadius="14"
                        Background="#4F46E5"
                        HorizontalAlignment="Left">
                    <TextBlock Text="T"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="TuitionDesk"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,20,0,4" />
                <TextBlock x:Name="LoadingStatus"
                           Text="Starting your workspace…"
                           FontSize="14"
                           Foreground="#64748B"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
