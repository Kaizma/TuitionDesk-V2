root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{xaml,xml,props,targets,csproj,slnx}]
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,iss}]
indent_style = space
indent_size = 4
